<Window
    x:Class="Dropstone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dropstone Installer">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="AppHeader" Grid.Row="0" Padding="28,24,28,12" Spacing="4">
            <TextBlock Text="Dropstone" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Deploy your own payload files into LeviLauncher version folders."
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,8,28,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="SetupPanel" Spacing="16">
                    <InfoBar
                        x:Name="PresetInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational"
                        Title="Deployment preset loaded" />
                    <InfoBar
                        x:Name="LauncherInfoBar"
                        IsClosable="False"
                        IsOpen="True" />

                    <Button
                        x:Name="LocateLauncherButton"
                        Content="Locate LeviLauncher.exe..."
                        Click="LocateLauncher_Click" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Install location" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="InstallPathBox"
                                AutomationProperties.Name="Install location"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Content="Browse..."
                                Click="BrowseInstall_Click" />
                        </Grid>
                        <TextBlock
                            Text="The logic files are copied here and the payload is kept in a 'payload' subfolder."
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <InfoBar
                        x:Name="SetupErrorBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Error" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="NextButton"
                            Content="Continue"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Next_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="InstalledPanel" Spacing="16" Visibility="Collapsed">
                    <InfoBar
                        x:Name="InstalledInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Success"
                        Title="Dropstone is already installed" />
                    <TextBlock
                        x:Name="InstalledSummaryText"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ReplaceButton"
                            Content="Replace payload"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Replace_Click" />
                        <Button
                            x:Name="OpenPayloadButton"
                            Content="Open payload folder"
                            Click="OpenPayload_Click" />
                        <Button
                            x:Name="UninstallButton"
                            Content="Uninstall"
                            Click="Uninstall_Click" />
                        <Button Content="Close" Click="Close_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ArchivePanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock
                        x:Name="ArchiveTitleText"
                        Text="Choose payload source"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Select a .zip or .rar containing the files to deploy, or a single .dll. Archives are extracted into the install folder's 'payload' directory, and a .dll is copied there directly. You can also use the payload preset in config.ini."
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                    <Button Content="Browse for payload..." Click="BrowseArchive_Click" />
                    <TextBlock
                        x:Name="ArchivePathText"
                        Text="No payload selected."
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <InfoBar
                        x:Name="ArchiveErrorBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Error" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="InstallButton"
                            Content="Install"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Install_Click" />
                        <Button Content="Back" Click="Back_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="ProgressPanel"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
                    <ProgressRing
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        IsActive="True" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="ProgressBar"
                            VerticalAlignment="Center"
                            Value="0" />
                        <TextBlock
                            x:Name="ProgressPercentText"
                            Grid.Column="1"
                            MinWidth="36"
                            VerticalAlignment="Center"
                            TextAlignment="Right"
                            Text="0%" />
                    </Grid>
                    <TextBlock
                        x:Name="ProgressText"
                        Text="Working..."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="ResultPanel"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="ResultIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="40"
                        Glyph="&#xE73E;" />
                    <TextBlock x:Name="ResultTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="ResultMessage"
                        Opacity="0.8"
                        TextWrapping="Wrap" />
                    <Button
                        Content="Close"
                        Margin="0,8,0,0"
                        Click="Close_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock
            Grid.Row="2"
            Margin="28,4,28,20"
            FontSize="12"
            Opacity="0.55"
            Text="Tooling only - no payload files are included. You are responsible for the files you deploy."
            TextWrapping="Wrap" />
    </Grid>
</Window>
